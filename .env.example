# PostgreSQL connection string.
# Local dev: postgresql://postgres:<password>@localhost:5432/fincontrol?schema=public
# Production (Vercel): use Neon / Vercel Postgres connection string.
DATABASE_URL=""

# Generate with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (Google Cloud Console > Credentials > OAuth Client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Apple OAuth (Apple Developer > Certificates, Identifiers & Profiles)
# APPLE_CLIENT_ID is your Services ID (e.g. app.fincontrol.signin).
# APPLE_CLIENT_SECRET is NOT a fixed string — it's a JWT signed with your .p8 private key
# (Team ID + Key ID), valid for at most 6 months. Generate/renew with `npx auth apple secret`.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
