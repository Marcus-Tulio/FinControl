# PostgreSQL connection string.
# Local dev: postgresql://postgres:<password>@localhost:5432/fincontrol?schema=public
# Production (Vercel): use Neon / Vercel Postgres connection string.
DATABASE_URL=""

# Generate with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (Google Cloud Console > Credentials > OAuth Client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Apple OAuth (Apple Developer > Certificates, Identifiers & Profiles)
# APPLE_CLIENT_ID is your Services ID (e.g. app.fincontrol.signin).
# APPLE_CLIENT_SECRET is NOT a fixed string — it's a JWT signed with your .p8 private key
# (Team ID + Key ID), valid for at most 6 months. Generate/renew with `npx auth apple secret`.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Optional: Microsoft/Outlook OAuth (Azure Portal > Microsoft Entra ID > App registrations)
# Accepts personal Microsoft accounts (Outlook/Hotmail/Live) and work/school accounts.
# Redirect URI to register: <your-url>/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Required for "esqueci minha senha": Resend (resend.com) API key.
# Without a verified sending domain on Resend, emails can only be delivered to the
# address you signed up to Resend with (sandbox mode) — verify a domain to send to any user.
RESEND_API_KEY=""
# Sender shown on password-reset emails. "onboarding@resend.dev" works without domain verification
# (sandbox mode only); switch to an address on your own verified domain for real users.
EMAIL_FROM="FinControl <onboarding@resend.dev>"
