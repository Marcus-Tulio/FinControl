generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js) ----------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  pinHash        String?
  currency       String    @default("BRL")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  financialAccounts   FinancialAccount[]
  categories          Category[]
  transactions        Transaction[]
  recurringRules      RecurringRule[]
  budgets             Budget[]
  goals               Goal[]
  debts               Debt[]
  investments         Investment[]
  notifications       Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain enums ----------

enum FinancialAccountType {
  CHECKING
  SAVINGS
  DIGITAL_WALLET
  CASH
  INVESTMENT
}

enum CategoryKind {
  INCOME
  EXPENSE
  INVESTMENT
}

enum TransactionKind {
  INCOME
  EXPENSE
  INVESTMENT
  TRANSFER
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DebtType {
  LOAN
  FINANCING
  INSTALLMENT
  CREDIT_CARD
  OTHER
}

enum InvestmentType {
  FIXED_INCOME
  STOCK
  ETF
  FUND
  CRYPTO
  PENSION
  OTHER
}

enum InvestmentMovementType {
  CONTRIBUTION
  WITHDRAWAL
  DIVIDEND
  PRICE_UPDATE
}

enum GoalType {
  EMERGENCY_FUND
  TRAVEL
  CAR
  HOUSE
  INVESTMENT
  DEBT_PAYOFF
  CUSTOM
}

enum NotificationType {
  BILL_DUE
  BUDGET_ALERT
  SPENDING_TREND
  GOAL_PROGRESS
  DEBT_DUE
  SYSTEM
}

// ---------- Financial accounts ----------

model FinancialAccount {
  id        String               @id @default(cuid())
  userId    String
  name      String
  type      FinancialAccountType
  institution String?
  color     String               @default("#6366f1")
  icon      String               @default("wallet")
  initialBalance Decimal         @default(0) @db.Decimal(14, 2)
  archived  Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("AccountTransactions")
  transfersIn  Transaction[] @relation("TransferDestination")

  @@index([userId])
}

// ---------- Categories ----------

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  kind      CategoryKind
  icon      String       @default("shapes")
  color     String       @default("#6366f1")
  parentId  String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("Subcategories", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[]   @relation("Subcategories")
  transactions Transaction[]
  budgets      Budget[]

  @@index([userId])
}

// ---------- Recurring rules (assinaturas, contas fixas, receitas recorrentes) ----------

model RecurringRule {
  id              String              @id @default(cuid())
  userId          String
  financialAccountId String
  categoryId      String?
  kind            TransactionKind
  description     String
  amount          Decimal             @db.Decimal(14, 2)
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  startDate       DateTime
  endDate         DateTime?
  dayOfMonth      Int?
  isEssential     Boolean             @default(false)
  isSubscription  Boolean             @default(false)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// ---------- Transactions ----------

model Transaction {
  id                  String            @id @default(cuid())
  userId              String
  financialAccountId  String
  transferToAccountId String?
  categoryId          String?
  recurringRuleId     String?
  kind                TransactionKind
  status              TransactionStatus @default(PAID)
  description         String
  notes               String?
  amount              Decimal           @db.Decimal(14, 2)
  date                DateTime
  dueDate             DateTime?
  paidDate            DateTime?
  isEssential         Boolean           @default(true)
  tags                String[]          @default([])
  installmentGroupId  String?
  installmentNumber   Int?
  installmentTotal    Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation("AccountTransactions", fields: [financialAccountId], references: [id], onDelete: Cascade)
  transferToAccount FinancialAccount? @relation("TransferDestination", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule   RecurringRule?    @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, status, dueDate])
  @@index([installmentGroupId])
}

// ---------- Budgets ----------

model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  month       Int
  year        Int
  limitAmount Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

// ---------- Goals ----------

model Goal {
  id               String   @id @default(cuid())
  userId           String
  name             String
  type             GoalType
  icon             String   @default("target")
  color            String   @default("#6366f1")
  targetAmount     Decimal  @db.Decimal(14, 2)
  currentAmount    Decimal  @default(0) @db.Decimal(14, 2)
  targetDate       DateTime?
  isCompleted      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime
  note      String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

// ---------- Debts ----------

model Debt {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  type               DebtType
  originalAmount     Decimal  @db.Decimal(14, 2)
  remainingAmount    Decimal  @db.Decimal(14, 2)
  interestRate       Decimal  @default(0) @db.Decimal(6, 3)
  installmentsTotal  Int?
  installmentsPaid   Int      @default(0)
  installmentAmount  Decimal? @db.Decimal(14, 2)
  dueDay             Int?
  nextDueDate        DateTime?
  isPaidOff          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId])
}

model DebtPayment {
  id     String   @id @default(cuid())
  debtId String
  amount Decimal  @db.Decimal(14, 2)
  date   DateTime
  note   String?

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
}

// ---------- Investments ----------

model Investment {
  id              String         @id @default(cuid())
  userId          String
  name            String
  type            InvestmentType
  broker          String?
  ticker          String?
  quantity        Decimal        @default(0) @db.Decimal(18, 6)
  avgPrice        Decimal        @default(0) @db.Decimal(14, 4)
  currentPrice    Decimal        @default(0) @db.Decimal(14, 4)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements InvestmentMovement[]

  @@index([userId])
}

model InvestmentMovement {
  id           String                  @id @default(cuid())
  investmentId String
  type         InvestmentMovementType
  amount       Decimal                 @db.Decimal(14, 2)
  quantity     Decimal?                @db.Decimal(18, 6)
  price        Decimal?                @db.Decimal(14, 4)
  date         DateTime

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
}

// ---------- Notifications ----------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
